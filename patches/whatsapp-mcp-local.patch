@@ -0,0 +1,59 @@
+import unittest
+from datetime import datetime, timezone
+import os
+import sqlite3
+import tempfile
+from unittest.mock import patch
+
+from main import _to_jsonable, download_media as mcp_download_media
+from whatsapp import Chat
+import whatsapp
+
+
+class SerializationTests(unittest.TestCase):
+    def test_dataclass_results_are_converted_to_json_values(self):
+        chat = Chat(
+            jid="123@g.us",
+            name="Example",
+            last_message_time=datetime(2026, 11, 21, 12, 0, tzinfo=timezone.utc),
+        )
+
+        result = _to_jsonable([chat])
+
+        self.assertEqual(result[0]["jid"], "123@g.us")
+        self.assertEqual(result[0]["name"], "Example")
+        self.assertEqual(result[0]["last_message_time"], "2026-11-21T12:00:00+00:00")
+
+    def test_list_chats_without_last_message_does_not_reference_messages_table(self):
+        with tempfile.TemporaryDirectory() as directory:
+            database = os.path.join(directory, "messages.db")
+            connection = sqlite3.connect(database)
+            connection.execute(
+                "CREATE TABLE chats (jid TEXT PRIMARY KEY, name TEXT, last_message_time TEXT)"
+            )
+            connection.execute(
+                "INSERT INTO chats VALUES (?, ?, ?)",
+                ("123@g.us", "Example", "2026-11-21T12:00:00+00:00"),
+            )
+            connection.commit()
+            connection.close()
+
+            with patch.object(whatsapp, "MESSAGES_DB_PATH", database):
+                result = whatsapp.list_chats(limit=1, include_last_message=False)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0].jid, "123@g.us")
+
+    def test_download_media_exposes_bridge_error_message(self):
+        with patch(
+            "main.whatsapp_download_media",
+            return_value=(None, "HTTP 500: WhatsApp CDN returned 403"),
+        ):
+            result = mcp_download_media("message-id", "chat-id")
+
+        self.assertFalse(result["success"])
+        self.assertEqual(result["message"], "HTTP 500: WhatsApp CDN returned 403")
+
+
+if __name__ == "__main__":
+    unittest.main()
