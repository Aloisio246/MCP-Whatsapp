+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalServerAddressBindsLoopbackOnly(t *testing.T) {
+	got := localServerAddress(8080)
+	want := "127.0.0.1:8080"
+	if got != want {
+		t.Fatalf("localServerAddress(8080) = %q, want %q", got, want)
+	}
+}
+
+func TestExtractDirectPathFromURLPreservesDownloadQuery(t *testing.T) {
+	got := extractDirectPathFromURL("https://mmg.whatsapp.net/v/t62.7118-24/audio.enc?ccb=11-4&oh=signed-token")
+	want := "/v/t62.7118-24/audio.enc?ccb=11-4&oh=signed-token"
+	if got != want {
+		t.Fatalf("extractDirectPathFromURL() = %q, want %q", got, want)
+	}
+}
+
+func TestWriteQRCodePNGCreatesPNGFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "whatsapp-qr.png")
+	if err := writeQRCodePNG("test-pairing-payload", path); err != nil {
+		t.Fatalf("writeQRCodePNG returned an error: %v", err)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("reading QR image: %v", err)
+	}
+	if !bytes.HasPrefix(data, []byte("\x89PNG\r\n\x1a\n")) {
+		t.Fatalf("QR image does not have a PNG signature")
+	}
+}
